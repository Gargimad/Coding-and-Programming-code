    def update_cities_dropdown(self):
        """Update the cities dropdown with current cities"""
        cities = self.db.fetchCities()
        city_names = ["All Cities"] + [city[1] for city in cities]
        if hasattr(self, 'city_mb'):
            self.city_mb.configure(values=city_names)

    def handle_city_selection(self, choice):
        """Handle city selection from dropdown"""
        if choice == "All Cities":
            self.displayBusinesses(1, "Explore", 0)
        else:
            cities = self.db.fetchCities()
            for city_id, city_name in cities:
                if city_name == choice:
                    self.displayBusinesses(0, 0, city_id)
                    break

    # Selection of communities-------------------------------------------------------------------------------------------------------------------------------------
    def renderBusinessCards(self, businesses):
        colors = self.getColors()

        # Clearing existing cards first
        for widget in self.cardsFrame.winfo_children():
            widget.destroy()

        if not businesses:
            no_biz_label = ctk.CTkLabel(
                self.cardsFrame,
                text="No businesses found.",
                font=("Georgia", 12),
                text_color=colors["text"],
                fg_color="transparent"
            )
            no_biz_label.pack(pady=20)
            return

        for biz_id, biz_name, rating, review_count, description, website_link in businesses:
            if any(field is None for field in [biz_name, description, website_link]):
                continue

            # Business Card Frame
            bizCard = ctk.CTkFrame(
                self.cardsFrame,
                fg_color=colors["card"],
                border_width=2,
                border_color=colors["highlight"],
                corner_radius=10
            )
            bizCard.pack(fill="x", pady=10, padx=50)

            # Business Name
            name_label = ctk.CTkLabel(
                bizCard,
                text=biz_name,
                font=("Georgia", 18, "bold"),
                text_color=colors["cardText"],
                fg_color="transparent",
                anchor="w"
            )
            name_label.pack(anchor="w", padx=15, pady=(10, 5))

            # Rating Stars
            rateValue = float(rating) if rating else 0.0
            stars = "★" * int(rateValue) + "☆" * (5 - int(rateValue))
            rating_label = ctk.CTkLabel(
                bizCard,
                text=f"{stars} {rateValue} ({review_count or 0} reviews)",
                font=("Georgia", 12),
                text_color=colors["ratingStars"],
                fg_color="transparent",
                anchor="w"
            )
            rating_label.pack(anchor="w", padx=15, pady=2)

            # Description
            desc_label = ctk.CTkLabel(
                bizCard,
                text=description,
                font=("Georgia", 10),
                text_color=colors["cardText"],
                fg_color="transparent",
                anchor="w",
                wraplength=800,
                justify="left"
            )
            desc_label.pack(anchor="w", padx=15, pady=5)

            # Action Buttons Container
            actBtnCont = ctk.CTkFrame(bizCard, fg_color="transparent")
            actBtnCont.pack(fill="x", padx=15, pady=(5, 10))

            # Website Button
            website_btn = ctk.CTkButton(
                actBtnCont,
                text="Website Link",
                fg_color="#D16459",
                hover_color="#B04D3A",
                text_color=colors["buttonText"],
                font=("Georgia", 11),
                width=120,
                height=32,
                corner_radius=5,
                command=lambda link=website_link: self.openWebsite(link),
                cursor="hand2"
            )
            website_btn.pack(side="right", padx=5)

            if self.userEmail:
                bmSaved = self.db.isBookmarked(self.userEmail, biz_id)
                bmTxt = "🔖 Bookmarked" if bmSaved else "☆ Bookmark"
                bmColor = colors["bookmarkAdded"] if bmSaved else colors["bookmarkRemove"]

                # Bookmark Button (placed absolutely within the card)
                bmBtn = ctk.CTkButton(
                    bizCard,
                    text=bmTxt,
                    fg_color=bmColor,
                    hover_color=colors["highlight"],
                    text_color=colors["buttonText"],
                    font=("Georgia", 11),
                    width=100,
                    height=30,
                    corner_radius=5,
                    cursor="hand2"
                )
                bmBtn.place(relx=1.0, rely=0.0, x=-10, y=10, anchor="ne")
                bmBtn.configure(command=lambda b=biz_id, btn=bmBtn: self.onBookmarkToggle(b, btn))

                # Rate Button
                rate_btn = ctk.CTkButton(
                    actBtnCont,
                    text="Rate Business",
                    fg_color=colors["button"],
                    hover_color=colors["highlight"],
                    text_color=colors["buttonText"],
                    font=("Georgia", 11),
