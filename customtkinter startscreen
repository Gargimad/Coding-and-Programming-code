    def applyTheme(self):
        colors = self.getColors()

        # Update appearance mode
        ctk.set_appearance_mode("dark" if self.darkMode else "light")

        # Root background
        self.root.configure(fg_color=colors["bg"])

        # Update navigation bar buttons if they exist
        if hasattr(self, 'mb'):
            self.mb.configure(fg_color=colors["button"], button_color=colors["button"])

        if hasattr(self, 'coupsNDeals'):
            self.coupsNDeals.configure(fg_color=colors["button"])

        if hasattr(self, 'helpBtn'):
            self.helpBtn.configure(fg_color=colors["button"])

        if hasattr(self, 'bookmarks'):
            self.bookmarks.configure(fg_color=colors["button"])

        if hasattr(self, 'darkBtn'):
            self.darkBtn.configure(
                text="☀️ Light Mode" if self.darkMode else "🌙 Dark Mode",
                fg_color=colors["button"]
            )

        if hasattr(self, 'profileBtn'):
            self.profileBtn.configure(fg_color=colors["nav"], button_color=colors["button"])

        if hasattr(self, 'signup_btn'):
            self.signup_btn.configure(fg_color=colors["button"])

        if hasattr(self, 'login_btn'):
            self.login_btn.configure(fg_color=colors["button"])

        # Footer
        self.footer.configure(fg_color=colors["footer"], text_color="white")

        # Update results container
        self.resultsContainer.configure(fg_color=colors["bg"])
        
        if hasattr(self, 'scrollable_frame'):
            self.scrollable_frame.configure(fg_color=colors["bg"])

        self.homeUi()

        if not self.mainPageFrame.winfo_ismapped():
            self.mainPageFrame.place_forget()

        # Refresh current view
        self.refreshCurrentView()

    def toggleDarkMode(self):
        self.darkMode = not self.darkMode
        self.applyTheme()

    def refreshCurrentView(self):
        """Refresh the current view to apply theme changes"""
        if self.current_view == 'businesses' and self.current_sub_id is not None:
            self.displayBusinesses(self.current_sub_id, self.current_sub_name, self.current_city_id)
        elif self.current_view == 'coupons':
            self.showAllCouponsPage()
    def go_home(self):
        """Navigate to home page properly"""
        self.updateInstructions("Welcome Home! Select a category to start.")
        
        # Hide results container
        self.resultsContainer.pack_forget()  # or grid_forget()
        
        # Clear any existing widgets in results container
        for widget in self.resultsContainer.winfo_children():
            widget.destroy()
        
        # Show home page
        self.homeUi()