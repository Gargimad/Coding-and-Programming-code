    def showBusinessCoupons(self, biz_id, biz_name):
        colors = self.getColors()
        self.updateInstructions(f"Viewing deals for {biz_name}. Use the codes at checkout!")
        
        # Create a small popup window
        popup = ctk.CTkToplevel(self.root)
        popup.title(f"Deals for {biz_name}")
        popup.geometry("500x400")
        popup.configure(fg_color=colors["card"])

        # Make popup modal
        popup.grab_set()

        title_label = ctk.CTkLabel(
            popup,
            text=f"Coupons for {biz_name}",
            font=("Georgia", 14, "bold"),
            text_color=colors["cardText"],
            fg_color="transparent",
            pady=10
        )
        title_label.pack()

        # Fetch specific coupons
        coupons = self.db.fetchCouponsByBusiness(biz_id)

        if not coupons:
            no_coup_label = ctk.CTkLabel(
                popup,
                text="No active coupons for this business.",
                font=("Georgia", 11),
                text_color=colors["cardText"],
                fg_color="transparent"
            )
            no_coup_label.pack(pady=50)
        else:
            # Create scrollable frame for coupons
            scroll_frame = ctk.CTkScrollableFrame(popup, fg_color="transparent")
            scroll_frame.pack(fill="both", expand=True, padx=20, pady=10)

            for title, description, coupon_code in coupons:
                # Coupon card
                f = ctk.CTkFrame(
                    scroll_frame,
