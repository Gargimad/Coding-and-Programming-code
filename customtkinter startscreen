                    f,
                    text=title,
                    font=("Georgia", 12, "bold"),
                    text_color=colors["accent"],
                    fg_color="transparent",
                    anchor="w"
                )
                title_label.pack(anchor="w", padx=10, pady=(10, 5))

                # Coupon description
                desc_label = ctk.CTkLabel(
                    f,
                    text=description,
                    font=("Georgia", 10),
                    text_color=colors["cardText"],
                    fg_color="transparent",
                    anchor="w",
                    wraplength=400
                )
                desc_label.pack(anchor="w", padx=10, pady=2)

                # Coupon code
